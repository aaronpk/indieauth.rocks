SITE_NAME=IndieAuth Rocks

# The public URL of the test suite. It is the client_id host for server tests
# and the IndieAuth server host for client tests.
BASE_URL=https://indieauth.rocks/

# A second hostname served by this same app, on a different origin from
# BASE_URL. Server tests use it to check that servers refuse unregistered
# cross-origin redirect URIs; client tests use it for other-domain profiles.
ALT_BASE_URL=https://redirect.indieauth.rocks/

# Development only: a hostname serving a static profile page for automated
# end-to-end runs (see README).
# FIXTURE_BASE_URL=https://e2e-profile.pad/

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=indieauthrocks
DB_USER=indieauthrocks
DB_PASS=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PREFIX=iar:

# 64 hex characters, e.g. `openssl rand -hex 32`. Encrypts tokens held during
# a test run.
APP_SECRET=

DEBUG=0
TRUST_PROXY=0

# Development only. Allow test requests to loopback (127.0.0.0/8) or private
# network addresses, and trust an extra CA file for local certificates.
ALLOW_LOOPBACK_FETCH=0
ALLOW_PRIVATE_FETCH=0
# EXTRA_CA_FILE=/web/conf/ssl/ca.crt

# Days to keep runs that were never published.
RUN_RETENTION_DAYS=30

# Days to keep login checkups. Shorter than a test run: a checkup diagnoses one
# person's login once, and its page is shareable by whoever has the link.
CHECKUP_RETENTION_DAYS=7

# LOG_FILE=/var/log/indieauth.rocks/app.log
