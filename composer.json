{
    "name": "aaronpk/indieauth.rocks",
    "description": "A test suite for IndieAuth servers and clients",
    "type": "project",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.2",
        "php-64bit": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "IndieAuthRocks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IndieAuthRocks\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
